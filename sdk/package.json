{
  "name": "@agentdid/sdk",
  "version": "1.0.0-rc.4",
  "description": "TypeScript SDK for creating, signing, and verifying Agent-DIDs based on RFC-001. Decentralized identity for autonomous AI agents with Ed25519 signatures, HTTP Bot Auth, and EVM registry support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "api:snapshot": "node ./scripts/public-api-snapshot.mjs --write",
    "api:check": "node ./scripts/public-api-snapshot.mjs --check",
    "api:signature:snapshot": "node ./scripts/public-api-signature-snapshot.mjs --write",
    "api:signature:check": "node ./scripts/public-api-signature-snapshot.mjs --check",
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run api:check && npm run api:signature:check && npm run build && npm test"
  },
  "keywords": [
    "did",
    "agent",
    "ai",
    "web3",
    "identity",
    "decentralized-identity",
    "verifiable-credentials",
    "ed25519",
    "agent-did",
    "rfc-001",
    "autonomous-agents",
    "bot-auth",
    "http-signatures",
    "zero-trust"
  ],
  "author": "Edison Munoz <edison.munoz@agent-did.org>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/edisonduran/agent-did.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/edisonduran/agent-did#readme",
  "bugs": {
    "url": "https://github.com/edisonduran/agent-did/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "bs58": "^6.0.0",
    "didwebvh-ts": "~3.0.0",
    "multiformats": "^13.1.0",
    "structured-headers": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^8.0.7",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.2.0",
    "fast-check": "^4.10.2",
    "http-message-signatures": "1.0.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.2"
  }
}
