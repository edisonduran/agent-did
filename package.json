{
  "name": "agent-did",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/edisonduran/agent-did.git"
  },
  "homepage": "https://github.com/edisonduran/agent-did#readme",
  "scripts": {
    "api:snapshot": "npm run api:snapshot:ts && npm run api:signature:snapshot:ts && npm run api:snapshot:python && npm run api:signature:snapshot:python",
    "api:check": "npm run api:check:ts && npm run api:signature:check:ts && npm run api:check:python && npm run api:signature:check:python",
    "api:snapshot:ts": "npm --prefix sdk run api:snapshot",
    "api:check:ts": "npm --prefix sdk run api:check",
    "api:signature:snapshot:ts": "npm --prefix sdk run api:signature:snapshot",
    "api:signature:check:ts": "npm --prefix sdk run api:signature:check",
    "api:snapshot:python": "python sdk-python/scripts/public_api_snapshot.py --write",
    "api:check:python": "python sdk-python/scripts/public_api_snapshot.py --check",
    "api:signature:snapshot:python": "python sdk-python/scripts/public_api_signature_snapshot.py --write",
    "api:signature:check:python": "python sdk-python/scripts/public_api_signature_snapshot.py --check",
    "audit:contracts": "node scripts/contract-audit.js",
    "build:crewai": "cd integrations/crewai && python -m build",
    "build:semantic-kernel": "cd integrations/semantic-kernel && python -m build",
    "crewai:install-runtime": "cd integrations/crewai && python -m pip install -e \".[runtime]\"",
    "interop:ts": "npm --prefix sdk test -- --runInBand InteropVectors.test.ts crypto.test.ts",
    "interop:python": "python -m pytest sdk-python/tests/test_interop_vectors.py -q",
    "interop:check": "npm run interop:ts && npm run interop:python",
    "langchain-python:install-dev": "cd sdk-python && python -m pip install -e .[dev] && cd ..\\integrations\\langchain-python && python -m pip install -e .[dev]",
    "lint:crewai": "python -m ruff check integrations/crewai/src integrations/crewai/tests integrations/crewai/examples",
    "lint:semantic-kernel": "python -m ruff check integrations/semantic-kernel/src integrations/semantic-kernel/tests integrations/semantic-kernel/examples",
    "lint:langchain-python": "python -m ruff check integrations/langchain-python/src integrations/langchain-python/tests integrations/langchain-python/examples",
    "semantic-kernel:install-dev": "cd sdk-python && python -m pip install -e .[dev] && cd ..\\integrations\\semantic-kernel && python -m pip install -e .[dev]",
    "python:install-dev": "cd sdk-python && python -m pip install -e \".[dev]\"",
    "python:test": "cd sdk-python && python -m pytest tests/ -v --tb=short",
    "python:conformance": "cd sdk-python && python scripts/conformance_rfc001.py",
    "test:a2a": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/a2a/src']; raise SystemExit(pytest.main(['integrations/a2a/tests','-q']))\"",
    "test:crewai": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/crewai/src']; raise SystemExit(pytest.main(['integrations/crewai/tests','-q']))\"",
    "test:crewai-runtime": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/crewai/src']; raise SystemExit(pytest.main(['integrations/crewai/tests/test_runtime_smoke.py','-q']))\"",
    "test:langchain": "npm --prefix sdk run build && npm --prefix integrations/langchain test",
    "test:langchain-python": "python -m pip install -e \"sdk-python[dev]\" && python -m pip install -e \"integrations/langchain-python[dev]\" && python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/langchain-python/src']; raise SystemExit(pytest.main(['integrations/langchain-python/tests','-q']))\"",
    "test:microsoft-agent-framework": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/microsoft-agent-framework/src']; raise SystemExit(pytest.main(['integrations/microsoft-agent-framework/tests','-q']))\"",
    "test:microsoft-agent-framework-runtime": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/microsoft-agent-framework/src']; raise SystemExit(pytest.main(['integrations/microsoft-agent-framework/tests/test_runtime_smoke.py','-q']))\"",
    "test:semantic-kernel": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/semantic-kernel/src']; raise SystemExit(pytest.main(['integrations/semantic-kernel/tests','-q']))\"",
    "test:semantic-kernel-runtime": "python -c \"import sys, pytest; sys.path[:0]=['sdk-python/src','integrations/semantic-kernel/src']; raise SystemExit(pytest.main(['integrations/semantic-kernel/tests/test_runtime_smoke.py','-q']))\"",
    "typecheck:crewai": "python -m mypy integrations/crewai/src",
    "typecheck:semantic-kernel": "python -m mypy integrations/semantic-kernel/src",
    "typecheck:langchain-python": "python -m mypy integrations/langchain-python/src",
    "smoke:langchain-didwba": "node scripts/langchain-didwba-demo-smoke.mjs",
    "smoke:e2e": "node scripts/e2e-smoke.js",
    "smoke:ha": "node scripts/resolver-ha-smoke.js",
    "smoke:webvh-external": "node scripts/webvh-external-smoke.js",
    "smoke:policy": "node scripts/revocation-policy-smoke.js",
    "smoke:rpc": "node scripts/rpc-resolver-smoke.js",
    "python:smoke:webvh-external": "cd sdk-python && python scripts/webvh_external_smoke.py",
    "conformance:rfc001": "node scripts/conformance-rfc001.js",
    "check:integration-governance": "node scripts/check-integration-governance.js",
    "test:python": "npm run python:test"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1"
  }
}
