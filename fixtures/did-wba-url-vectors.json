{
  "formatVersion": 1,
  "description": "Cross-SDK vectors for the did:wba DID -> document URL derivation. After percent-decoding, the domain segment must be a DNS name (ASCII letter/digit/hyphen labels, no IP literal, no numeric last label) with an optional port encoded as %3A; the host is lowercased and port 443 is dropped. Path segments are decoded, must not be '.' or '..', and are re-encoded keeping only RFC 3986 unreserved characters. `url` is the URL both SDKs must fetch; `invalid: true` means both SDKs must reject the DID before any fetch.",
  "vectors": [
    { "did": "did:wba:agents.example", "url": "https://agents.example/.well-known/did.json" },
    { "did": "did:wba:agents.example%3A8443:profiles:alice", "url": "https://agents.example:8443/profiles/alice/did.json" },
    { "did": "did:wba:agents.example%3a8443", "url": "https://agents.example:8443/.well-known/did.json", "note": "lowercase percent-encoding of the port separator" },
    { "did": "did:wba:Agents.EXAMPLE:Bot", "url": "https://agents.example/Bot/did.json", "note": "host lowercased, path case kept" },
    { "did": "did:wba:agents.example%3A443:bot", "url": "https://agents.example/bot/did.json", "note": "default port dropped" },
    { "did": "did:wba:localhost%3A3000", "url": "https://localhost:3000/.well-known/did.json", "note": "single-label host" },
    { "did": "did:wba:1password.example:x-y_z.~", "url": "https://1password.example/x-y_z.~/did.json" },
    { "did": "did:wba:agents.example::bot:", "url": "https://agents.example/bot/did.json", "note": "empty path segments are ignored" },
    { "did": "did:wba:agents.example:a%20b:%E2%9C%93", "url": "https://agents.example/a%20b/%E2%9C%93/did.json" },
    { "did": "did:wba:agents.example:a(b)!*'", "url": "https://agents.example/a%28b%29%21%2A%27/did.json" },
    { "did": "did:wba:agents.example:users%2Falice", "url": "https://agents.example/users%2Falice/did.json", "note": "an encoded slash stays inside one segment" },

    { "did": "did:wba:victim.example%2Fuploads%2Fattacker.json%23", "invalid": true, "note": "slash and fragment in the domain" },
    { "did": "did:wba:victim.example%2Fuploads%2Fattacker.json%3F", "invalid": true, "note": "slash and query in the domain" },
    { "did": "did:wba:victim.example%2Fapi%2Fecho%3Fbody%3D:agents:x", "invalid": true, "note": "slash and query in the domain, with path segments" },
    { "did": "did:wba:attacker%40victim.example", "invalid": true, "note": "userinfo" },
    { "did": "did:wba:victim.example%5Cattacker.example", "invalid": true, "note": "backslash" },
    { "did": "did:wba:victim.example%20", "invalid": true, "note": "whitespace" },
    { "did": "did:wba:victim.example%09", "invalid": true, "note": "tab" },
    { "did": "did:wba:victim.example%252F", "invalid": true, "note": "percent sign left after decoding" },
    { "did": "did:wba:victim%zz.example", "invalid": true, "note": "malformed percent-encoding" },
    { "did": "did:wba:victim%FF.example", "invalid": true, "note": "not UTF-8" },
    { "did": "did:wba:b%C3%BCcher.example", "invalid": true, "note": "non-ASCII host" },
    { "did": "did:wba:%5B%3A%3A1%5D", "invalid": true, "note": "IPv6 literal" },
    { "did": "did:wba:%5B2001%3Adb8%3A%3A1%5D%3A8443", "invalid": true, "note": "IPv6 literal with port" },
    { "did": "did:wba:127.0.0.1", "invalid": true, "note": "IPv4 literal" },
    { "did": "did:wba:0x7f.1", "invalid": true, "note": "hexadecimal last label (read as IPv4 by URL parsers)" },
    { "did": "did:wba:victim.example.123", "invalid": true, "note": "numeric last label" },
    { "did": "did:wba:victim..example", "invalid": true, "note": "empty label" },
    { "did": "did:wba:victim.example.", "invalid": true, "note": "trailing dot" },
    { "did": "did:wba:-victim.example", "invalid": true, "note": "label starts with a hyphen" },
    { "did": "did:wba:victim-.example", "invalid": true, "note": "label ends with a hyphen" },
    { "did": "did:wba:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "invalid": true, "note": "label longer than 63 characters" },
    { "did": "did:wba:victim_name.example", "invalid": true, "note": "underscore in the host" },
    { "did": "did:wba:victim.example%3A", "invalid": true, "note": "empty port" },
    { "did": "did:wba:victim.example%3A0", "invalid": true, "note": "port 0" },
    { "did": "did:wba:victim.example%3A08443", "invalid": true, "note": "port with a leading zero" },
    { "did": "did:wba:victim.example%3A65536", "invalid": true, "note": "port out of range" },
    { "did": "did:wba:victim.example%3A8443%3A1", "invalid": true, "note": "two ports" },
    { "did": "did:wba:victim.example:..:admin", "invalid": true, "note": "dot-dot path segment" },
    { "did": "did:wba:victim.example:%2E", "invalid": true, "note": "encoded dot path segment" },
    { "did": "did:wba:victim.example:%E0%A4%A", "invalid": true, "note": "malformed percent-encoding in a path segment" },
    { "did": "did:wba:", "invalid": true, "note": "empty method-specific identifier" },
    { "did": "did:wba::bot", "invalid": true, "note": "missing domain" }
  ]
}
